{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/server",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "Generate Swagger",
      "showLog": true
    },
    {
      "name": "Debug ETL",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/etl",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "SERVER_PORT": "3001"
      },
      "showLog": true
    }
  ]
}
