            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/sign-in/staff",
          "host": ["{{base_url}}"],
          "path": ["auth", "sign-in", "staff"]
        },
        "description": "Autentica un miembro del staff (CRM) con teléfono y contraseña. Retorna una cookie `encargalo-session` con el JWT de sesión. Solo funciona con cuentas que tengan el rol Staff."
