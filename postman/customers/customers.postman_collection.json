            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Carlos\",\n  \"sur_name\": \"Ramírez\",\n  \"phone\": \"+573001112233\",\n  \"email\": \"carlos.ramirez@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/users",
          "host": ["{{base_url}}"],
          "path": ["users"]
        },
        "description": "Actualiza los datos del usuario autenticado. Actualización parcial: solo se modifican los campos presentes en el body (todos opcionales), el resto de la cuenta queda intacto. Requiere cookie `encargalo-session`. Roles: Customer, customer."
      }
    },
