        "url": {
          "raw": "{{base_url}}/users/change-password",
          "host": ["{{base_url}}"],
          "path": ["users", "change-password"]
        },
        "description": "Actualiza la contraseña del usuario autenticado. Requiere cookie `encargalo-session`. Roles: Customer, customer."
      }
    },
